{
  "identifier": "run.vineyard.typepacks.endpoint",
  "content_type": "vineyard:typepack",
  "version": "1.0.0",
  "name": "Endpoint",
  "description": "Host and endpoint forensic artifacts (files, processes, registry keys, services, mutexes, scheduled tasks) for DFIR and malware-behavior mapping.",
  "authors": [{ "name": "VINEYARD", "url": "https://vineyard.run" }],
  "license": "Apache-2.0",
  "distribution": {
    "kind": "git",
    "repository": "https://github.com/vineyard-run/typepacks",
    "ref": "v1.0.0",
    "path": "typepacks/endpoint.json"
  },
  "marketing_url": "https://vineyard.run/typepacks/endpoint",
  "thumbnail_url": "https://vineyard.run/typepacks/endpoint/icon.png",
  "types": [
    {
      "category": "endpoint",
      "name": "file",
      "display_name": "File",
      "description": "A file artifact observed on a host, with hashes and path.",
      "label_property": "file_name",
      "icon": "file-text",
      "color": "#94a3b8",
      "properties": {
        "file_name": { "type": "string", "description": "File name.", "optional": false },
        "file_path": { "type": "string", "description": "Full path on disk.", "optional": true },
        "sha256": { "type": "hash", "description": "SHA-256 of the file.", "optional": true, "validator": { "regex": "^[a-fA-F0-9]{64}$" } },
        "md5": { "type": "hash", "description": "MD5 of the file.", "optional": true, "validator": { "regex": "^[a-fA-F0-9]{32}$" } },
        "size_bytes": { "type": "integer", "description": "File size in bytes.", "optional": true, "validator": { "min": 0 } },
        "mime_type": { "type": "string", "description": "MIME / content type.", "optional": true },
        "signed": { "type": "boolean", "description": "Whether the file is digitally signed.", "optional": true }
      }
    },
    {
      "category": "endpoint",
      "name": "process",
      "display_name": "Process",
      "description": "A running process observed on a host.",
      "label_property": "process_name",
      "icon": "cpu",
      "color": "#818cf8",
      "properties": {
        "process_name": { "type": "string", "description": "Process image name.", "optional": false },
        "process_guid": { "type": "string", "description": "Stable per-execution id (e.g. Sysmon/EDR ProcessGuid) — the reliable process identity, since image names and PIDs both recur.", "optional": true },
        "pid": { "type": "integer", "description": "Process identifier.", "optional": true, "validator": { "min": 0 } },
        "parent_pid": { "type": "integer", "description": "Parent process identifier.", "optional": true, "validator": { "min": 0 } },
        "command_line": { "type": "text", "description": "Full command line.", "optional": true },
        "user": { "type": "string", "description": "User the process ran as.", "optional": true },
        "start_time": { "type": "datetime", "description": "Process start time.", "optional": true }
      }
    },
    {
      "category": "endpoint",
      "name": "registry_key",
      "display_name": "Registry Key",
      "description": "A Windows registry key or value.",
      "label_property": "key_path",
      "icon": "key",
      "color": "#f87171",
      "properties": {
        "key_path": { "type": "string", "description": "Full registry key path.", "optional": false },
        "hive": {
          "type": "enum",
          "description": "Registry hive.",
          "optional": true,
          "enum": ["HKLM", "HKCU", "HKCR", "HKU", "HKCC"]
        },
        "value_name": { "type": "string", "description": "Value name under the key.", "optional": true },
        "value_data": { "type": "text", "description": "Value data.", "optional": true }
      }
    },
    {
      "category": "endpoint",
      "name": "service",
      "display_name": "Service",
      "description": "A Windows service or system daemon.",
      "label_property": "service_name",
      "icon": "cog",
      "color": "#fb923c",
      "properties": {
        "service_name": { "type": "string", "description": "Service name.", "optional": false },
        "display_name": { "type": "string", "description": "Service display name.", "optional": true },
        "binary_path": { "type": "string", "description": "Path to the service binary.", "optional": true },
        "start_type": {
          "type": "enum",
          "description": "Start configuration.",
          "optional": true,
          "enum": ["auto", "manual", "disabled", "boot", "system"]
        },
        "state": {
          "type": "enum",
          "description": "Current run state.",
          "optional": true,
          "enum": ["running", "stopped", "paused", "start_pending", "stop_pending", "pause_pending", "continue_pending"]
        }
      }
    },
    {
      "category": "endpoint",
      "name": "mutex",
      "display_name": "Mutex",
      "description": "A named synchronization object, commonly used by malware as an infection marker.",
      "label_property": "name",
      "icon": "lock",
      "color": "#fbbf24",
      "properties": {
        "name": { "type": "string", "description": "Mutex name.", "optional": false },
        "created_by": { "type": "string", "description": "Process or sample that created the mutex.", "optional": true }
      }
    },
    {
      "category": "endpoint",
      "name": "persistence",
      "display_name": "Persistence",
      "description": "A persistence mechanism — a scheduled task, autostart Run key, startup-folder entry, WMI subscription, or similar.",
      "label_property": "name",
      "icon": "calendar",
      "color": "#4ade80",
      "properties": {
        "name": { "type": "string", "description": "Task / entry name.", "optional": false },
        "mechanism": {
          "type": "enum",
          "description": "Persistence mechanism.",
          "optional": true,
          "enum": ["scheduled_task", "run_key", "service", "startup_folder", "wmi", "other"]
        },
        "trigger": { "type": "string", "description": "What triggers execution.", "optional": true },
        "action": { "type": "text", "description": "Command or action executed.", "optional": true }
      }
    }
  ],
  "edge_types": [
    {
      "category": "endpoint",
      "name": "spawned",
      "label": "spawned",
      "display_name": "Spawned",
      "description": "A parent process spawned a child process.",
      "from": ["endpoint.process"],
      "to": ["endpoint.process"]
    },
    {
      "category": "endpoint",
      "name": "executed",
      "label": "executed",
      "display_name": "Executed",
      "description": "A process executed from a file image.",
      "from": ["endpoint.process"],
      "to": ["endpoint.file"]
    },
    {
      "category": "endpoint",
      "name": "wrote",
      "label": "wrote",
      "display_name": "Wrote",
      "description": "A process wrote a file or registry key.",
      "from": ["endpoint.process"],
      "to": ["endpoint.file", "endpoint.registry_key"]
    },
    {
      "category": "endpoint",
      "name": "created_mutex",
      "label": "created mutex",
      "display_name": "Created Mutex",
      "description": "A process created a named mutex.",
      "from": ["endpoint.process"],
      "to": ["endpoint.mutex"]
    },
    {
      "category": "endpoint",
      "name": "installed",
      "label": "installed",
      "display_name": "Installed",
      "description": "A process or file installed a service or persistence mechanism.",
      "from": ["endpoint.process", "endpoint.file"],
      "to": ["endpoint.service", "endpoint.persistence"]
    },
    {
      "category": "endpoint",
      "name": "dropped",
      "label": "dropped",
      "display_name": "Dropped",
      "description": "A file dropped another file to disk.",
      "from": ["endpoint.file"],
      "to": ["endpoint.file"]
    },
    {
      "category": "endpoint",
      "name": "observed_on",
      "label": "observed on",
      "display_name": "Observed On",
      "description": "An endpoint artifact was observed on a host (e.g. an infrastructure.host).",
      "from": ["endpoint.process", "endpoint.file", "endpoint.registry_key", "endpoint.service", "endpoint.mutex", "endpoint.persistence"],
      "to": ["*"]
    }
  ]
}
