{
  "identifier": "run.vineyard.typepacks.identity",
  "content_type": "vineyard:typepack",
  "version": "1.2.0",
  "name": "Identity",
  "description": "People, organizations, and the online identities that connect them — personas, email addresses, phone numbers, and social/online accounts — for OSINT persona and attribution work.",
  "authors": [
    {
      "name": "VINEYARD",
      "url": "https://vineyard.run"
    }
  ],
  "license": "Apache-2.0",
  "distribution": {
    "kind": "git",
    "repository": "https://github.com/vineyard-run/typepacks",
    "ref": "v1.2.0",
    "path": "typepacks/identity.json"
  },
  "marketing_url": "https://vineyard.run/typepacks/identity",
  "thumbnail_url": "https://vineyard.run/typepacks/identity/icon.png",
  "types": [
    {
      "category": "identity",
      "name": "person",
      "display_name": "Person",
      "description": "A natural person or persona under investigation.",
      "label_property": "full_name",
      "icon": "user",
      "color": "#d8b4fe",
      "properties": {
        "full_name": {
          "type": "string",
          "description": "Full name or primary persona name.",
          "optional": false
        },
        "aliases": {
          "type": "text",
          "description": "Other names, nicknames, or handles.",
          "optional": true
        },
        "date_of_birth": {
          "type": "date",
          "description": "Date of birth.",
          "optional": true
        },
        "nationality": {
          "type": "string",
          "description": "Nationality or citizenship.",
          "optional": true
        },
        "gender": {
          "type": "string",
          "description": "Gender.",
          "optional": true
        },
        "occupation": {
          "type": "string",
          "description": "Occupation or role.",
          "optional": true
        }
      }
    },
    {
      "category": "identity",
      "name": "organization",
      "display_name": "Organization",
      "description": "A company, agency, group, or other organization.",
      "label_property": "name",
      "icon": "building-2",
      "color": "#c4b5fd",
      "properties": {
        "name": {
          "type": "string",
          "description": "Organization name.",
          "optional": false
        },
        "org_type": {
          "type": "enum",
          "description": "Kind of organization.",
          "optional": true,
          "enum": [
            "company",
            "government",
            "ngo",
            "educational",
            "criminal",
            "unknown"
          ]
        },
        "country": {
          "type": "string",
          "description": "Country of incorporation or operation.",
          "optional": true
        },
        "industry": {
          "type": "string",
          "description": "Industry or sector.",
          "optional": true
        },
        "website": {
          "type": "url",
          "description": "Primary website.",
          "optional": true
        },
        "registration_number": {
          "type": "string",
          "description": "Company / registration number.",
          "optional": true
        }
      }
    },
    {
      "category": "identity",
      "name": "email_address",
      "display_name": "Email Address",
      "description": "An email address tied to a person or organization.",
      "label_property": "email",
      "icon": "mail",
      "color": "#f472b6",
      "properties": {
        "email": {
          "type": "email",
          "description": "The email address.",
          "optional": false,
          "validator": {
            "regex": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$"
          }
        },
        "display_name": {
          "type": "string",
          "description": "Display name associated with the address.",
          "optional": true
        },
        "domain": {
          "type": "string",
          "description": "The domain part of the address.",
          "optional": true
        },
        "breached": {
          "type": "boolean",
          "description": "Seen in a known data breach.",
          "optional": true
        }
      }
    },
    {
      "category": "identity",
      "name": "phone_number",
      "display_name": "Phone Number",
      "description": "A telephone number in E.164 or local form.",
      "label_property": "number",
      "icon": "phone",
      "color": "#fb7185",
      "properties": {
        "number": {
          "type": "string",
          "description": "The phone number.",
          "optional": false,
          "validator": {
            "regex": "^\\+?[0-9 ().-]{5,}$"
          }
        },
        "country_code": {
          "type": "string",
          "description": "Dialing country code.",
          "optional": true
        },
        "carrier": {
          "type": "string",
          "description": "Carrier / network operator.",
          "optional": true
        },
        "line_type": {
          "type": "enum",
          "description": "Type of line.",
          "optional": true,
          "enum": [
            "mobile",
            "landline",
            "voip",
            "unknown"
          ]
        }
      }
    },
    {
      "category": "identity",
      "name": "handle",
      "display_name": "Handle",
      "description": "A name, alias, or nickname used by an as-yet-unidentified person or organization. Use it when a string is all you have: it names the actor without asserting whether they are a person, an organization, or one account. Resolve it into person / organization / user_account nodes as the investigation identifies them.",
      "label_property": "handle",
      "icon": "tag",
      "color": "#a78bfa",
      "properties": {
        "handle": {
          "type": "string",
          "description": "The handle, alias, or nickname as observed.",
          "optional": false
        },
        "first_seen_context": {
          "type": "text",
          "description": "Where the handle was observed — post, channel, leak, report.",
          "optional": true
        },
        "actor_kind": {
          "type": "enum",
          "description": "What the handle is believed to name, if anything is known yet.",
          "optional": true,
          "enum": [
            "unknown",
            "person",
            "organization",
            "group",
            "automated"
          ]
        },
        "confidence": {
          "type": "enum",
          "description": "Confidence that this handle is a meaningful investigative entity rather than noise.",
          "optional": true,
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "notes": {
          "type": "text",
          "description": "Free-form notes.",
          "optional": true
        }
      }
    },
    {
      "category": "identity",
      "name": "user_account",
      "display_name": "User Account",
      "description": "An online or social-media account / handle.",
      "label_property": "username",
      "identity_properties": [
        "username",
        "platform"
      ],
      "icon": "at-sign",
      "color": "#e879f9",
      "properties": {
        "username": {
          "type": "string",
          "description": "Username or handle.",
          "optional": false
        },
        "platform": {
          "type": "string",
          "description": "Platform or service (e.g. x, github, telegram).",
          "optional": true
        },
        "profile_url": {
          "type": "url",
          "description": "URL of the profile.",
          "optional": true
        },
        "display_name": {
          "type": "string",
          "description": "Display name shown on the platform.",
          "optional": true
        },
        "user_id": {
          "type": "string",
          "description": "Stable numeric / internal account id.",
          "optional": true
        },
        "followers": {
          "type": "integer",
          "description": "Follower count.",
          "optional": true,
          "validator": {
            "min": 0
          }
        },
        "created_date": {
          "type": "date",
          "description": "Account creation date.",
          "optional": true
        }
      },
      "label_template": "{username} · {platform}"
    },
    {
      "category": "identity",
      "name": "pgp_key",
      "display_name": "PGP Key",
      "description": "An OpenPGP public key (certificate) observed in a public key directory — its fingerprint, key material summary, and the identities (User IDs) it binds to email addresses.",
      "label_property": "fingerprint",
      "icon": "key",
      "color": "#fbbf24",
      "properties": {
        "fingerprint": {
          "type": "hash",
          "description": "OpenPGP key fingerprint (v4: 40-hex SHA-1; v6: 64-hex SHA-256).",
          "optional": false,
          "validator": {
            "regex": "^(?:[a-fA-F0-9]{40}|[a-fA-F0-9]{64})$"
          }
        },
        "key_id": {
          "type": "string",
          "description": "Long key ID (v4: last 16 hex of the fingerprint; v6: last 32 hex).",
          "optional": true,
          "validator": {
            "regex": "^(?:[a-fA-F0-9]{16}|[a-fA-F0-9]{32})$"
          }
        },
        "algorithm": {
          "type": "string",
          "description": "Primary key algorithm (e.g. rsa, ed25519, cv25519, ecdsa).",
          "optional": true
        },
        "key_size": {
          "type": "integer",
          "description": "Key size in bits.",
          "optional": true
        },
        "creation_time": {
          "type": "datetime",
          "description": "Key creation timestamp.",
          "optional": true
        },
        "expiration_time": {
          "type": "datetime",
          "description": "Key expiration timestamp, if any.",
          "optional": true
        },
        "user_ids": {
          "type": "text",
          "description": "User IDs bound to the key, one per line (Name <email>).",
          "optional": true
        },
        "revoked": {
          "type": "boolean",
          "description": "Key carries a revocation signature.",
          "optional": true
        },
        "armored_key": {
          "type": "text",
          "description": "Full ASCII-armored public key block as fetched.",
          "optional": true
        },
        "sources": {
          "type": "text",
          "description": "Directories where the key was found, one per line (keys.openpgp.org, keyserver.ubuntu.com, pgpkeys.eu, keys.mailvelope.com, WKD).",
          "optional": true
        }
      }
    }
  ],
  "edge_types": [
    {
      "category": "identity",
      "name": "owns",
      "label": "owns",
      "display_name": "Owns",
      "description": "A person, organization, or unattributed handle owns an account, email, or phone number.",
      "from": [
        "identity.person",
        "identity.organization",
        "identity.handle"
      ],
      "to": [
        "identity.user_account",
        "identity.email_address",
        "identity.phone_number"
      ]
    },
    {
      "category": "identity",
      "name": "member_of",
      "label": "member of",
      "display_name": "Member Of",
      "description": "A person is a member of an organization.",
      "from": [
        "identity.person"
      ],
      "to": [
        "identity.organization"
      ]
    },
    {
      "category": "identity",
      "name": "affiliated_with",
      "label": "affiliated with",
      "display_name": "Affiliated With",
      "description": "An organization is affiliated with another organization.",
      "from": [
        "identity.organization"
      ],
      "to": [
        "identity.organization"
      ]
    },
    {
      "category": "identity",
      "name": "same_as",
      "label": "same as",
      "display_name": "Same As",
      "description": "Two personas or accounts are assessed to be the same identity.",
      "directed": false,
      "from": [
        "identity.person",
        "identity.user_account",
        "identity.handle"
      ],
      "to": [
        "identity.person",
        "identity.user_account",
        "identity.handle"
      ]
    },
    {
      "category": "identity",
      "name": "controls",
      "label": "controls",
      "display_name": "Controls",
      "description": "A person or organization controls another entity or asset.",
      "from": [
        "identity.person",
        "identity.organization",
        "identity.handle"
      ],
      "to": [
        "*"
      ]
    },
    {
      "category": "identity",
      "name": "key_bound_to",
      "label": "key bound to",
      "display_name": "Key Bound To",
      "description": "A PGP public key certifies (is bound to) an email address in one of its User IDs.",
      "from": [
        "identity.pgp_key"
      ],
      "to": [
        "identity.email_address"
      ]
    },
    {
      "category": "identity",
      "name": "resolves_to",
      "label": "resolves to",
      "display_name": "Resolves To",
      "description": "An unattributed handle has been identified as this person, organization, or account. Kept separate from `same_as` so the moment of attribution stays visible in the graph rather than being flattened into an equivalence.",
      "from": [
        "identity.handle"
      ],
      "to": [
        "identity.person",
        "identity.organization",
        "identity.user_account"
      ]
    }
  ]
}
