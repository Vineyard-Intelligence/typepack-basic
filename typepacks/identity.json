{
  "identifier": "run.vineyard.typepacks.identity",
  "content_type": "vineyard:typepack",
  "version": "1.0.0",
  "name": "Identity",
  "description": "People, organizations, and the online identities that connect them — personas, email addresses, phone numbers, and social/online accounts — for OSINT persona and attribution work.",
  "authors": [{ "name": "VINEYARD.RUN", "url": "https://vineyard.run" }],
  "license": "Apache-2.0",
  "distribution": {
    "kind": "git",
    "repository": "https://github.com/vineyard-run/typepacks",
    "ref": "v1.0.0",
    "path": "typepacks/identity.json"
  },
  "marketing_url": "https://vineyard.run/typepacks/identity",
  "thumbnail_url": "https://vineyard.run/typepacks/identity/icon.png",
  "types": [
    {
      "category": "identity",
      "name": "person",
      "display_name": "Person",
      "description": "A natural person or persona under investigation.",
      "label_property": "full_name",
      "icon": "user",
      "color": "#d8b4fe",
      "properties": {
        "full_name": { "type": "string", "description": "Full name or primary persona name.", "optional": false },
        "aliases": { "type": "text", "description": "Other names, nicknames, or handles.", "optional": true },
        "date_of_birth": { "type": "date", "description": "Date of birth.", "optional": true },
        "nationality": { "type": "string", "description": "Nationality or citizenship.", "optional": true },
        "gender": { "type": "string", "description": "Gender.", "optional": true },
        "occupation": { "type": "string", "description": "Occupation or role.", "optional": true }
      }
    },
    {
      "category": "identity",
      "name": "organization",
      "display_name": "Organization",
      "description": "A company, agency, group, or other organization.",
      "label_property": "name",
      "icon": "building-2",
      "color": "#c4b5fd",
      "properties": {
        "name": { "type": "string", "description": "Organization name.", "optional": false },
        "org_type": {
          "type": "enum",
          "description": "Kind of organization.",
          "optional": true,
          "enum": ["company", "government", "ngo", "educational", "criminal", "unknown"]
        },
        "country": { "type": "string", "description": "Country of incorporation or operation.", "optional": true },
        "industry": { "type": "string", "description": "Industry or sector.", "optional": true },
        "website": { "type": "url", "description": "Primary website.", "optional": true },
        "registration_number": { "type": "string", "description": "Company / registration number.", "optional": true }
      }
    },
    {
      "category": "identity",
      "name": "email_address",
      "display_name": "Email Address",
      "description": "An email address tied to a person or organization.",
      "label_property": "email",
      "icon": "mail",
      "color": "#f472b6",
      "properties": {
        "email": {
          "type": "email",
          "description": "The email address.",
          "optional": false,
          "validator": { "regex": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$" }
        },
        "display_name": { "type": "string", "description": "Display name associated with the address.", "optional": true },
        "domain": { "type": "string", "description": "The domain part of the address.", "optional": true },
        "breached": { "type": "boolean", "description": "Seen in a known data breach.", "optional": true }
      }
    },
    {
      "category": "identity",
      "name": "phone_number",
      "display_name": "Phone Number",
      "description": "A telephone number in E.164 or local form.",
      "label_property": "number",
      "icon": "phone",
      "color": "#fb7185",
      "properties": {
        "number": {
          "type": "string",
          "description": "The phone number.",
          "optional": false,
          "validator": { "regex": "^\\+?[0-9 ().-]{5,}$" }
        },
        "country_code": { "type": "string", "description": "Dialing country code.", "optional": true },
        "carrier": { "type": "string", "description": "Carrier / network operator.", "optional": true },
        "line_type": {
          "type": "enum",
          "description": "Type of line.",
          "optional": true,
          "enum": ["mobile", "landline", "voip", "unknown"]
        }
      }
    },
    {
      "category": "identity",
      "name": "user_account",
      "display_name": "User Account",
      "description": "An online or social-media account / handle.",
      "label_property": "username",
      "icon": "at-sign",
      "color": "#e879f9",
      "properties": {
        "username": { "type": "string", "description": "Username or handle.", "optional": false },
        "platform": { "type": "string", "description": "Platform or service (e.g. x, github, telegram).", "optional": true },
        "profile_url": { "type": "url", "description": "URL of the profile.", "optional": true },
        "display_name": { "type": "string", "description": "Display name shown on the platform.", "optional": true },
        "user_id": { "type": "string", "description": "Stable numeric / internal account id.", "optional": true },
        "followers": { "type": "integer", "description": "Follower count.", "optional": true, "validator": { "min": 0 } },
        "created_date": { "type": "date", "description": "Account creation date.", "optional": true }
      }
    }
  ],
  "edge_types": [
    {
      "category": "identity",
      "name": "owns",
      "label": "owns",
      "display_name": "Owns",
      "description": "A person or organization owns an account, email, or phone number.",
      "from": ["identity.person", "identity.organization"],
      "to": ["identity.user_account", "identity.email_address", "identity.phone_number"]
    },
    {
      "category": "identity",
      "name": "member_of",
      "label": "member of",
      "display_name": "Member Of",
      "description": "A person is a member of an organization.",
      "from": ["identity.person"],
      "to": ["identity.organization"]
    },
    {
      "category": "identity",
      "name": "affiliated_with",
      "label": "affiliated with",
      "display_name": "Affiliated With",
      "description": "An organization is affiliated with another organization.",
      "from": ["identity.organization"],
      "to": ["identity.organization"]
    },
    {
      "category": "identity",
      "name": "same_as",
      "label": "same as",
      "display_name": "Same As",
      "description": "Two personas or accounts are assessed to be the same identity.",
      "directed": false,
      "from": ["identity.person", "identity.user_account"],
      "to": ["identity.person", "identity.user_account"]
    },
    {
      "category": "identity",
      "name": "controls",
      "label": "controls",
      "display_name": "Controls",
      "description": "A person or organization controls another entity or asset.",
      "from": ["identity.person", "identity.organization"],
      "to": ["*"]
    }
  ]
}
